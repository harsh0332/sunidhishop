# ==============================================================================
# SUNIDHI.SHOP - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Security Principle: NEVER put Google service account keys or admin secrets into
# NEXT_PUBLIC_* variables. Keep all credentials strictly server-side.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN
# ------------------------------------------------------------------------------
# Production canonical domain (used for SEO, OpenGraph, Canonical URLs)
NEXT_PUBLIC_SITE_URL=https://sunidhi.shop
NODE_ENV=production
DEFAULT_CURRENCY=INR

# ------------------------------------------------------------------------------
# 2. DATA SOURCE CONFIGURATION
# ------------------------------------------------------------------------------
# Data Source: 'google-sheets' (production live CMS) or 'mock' (local testing)
DATA_SOURCE=google-sheets

# The spreadsheet ID from the Google Sheet URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# The exact tab/sheet name containing products (Default: Products)
GOOGLE_SHEET_NAME=Products

# ------------------------------------------------------------------------------
# 3. GOOGLE CLOUD SERVICE ACCOUNT (Strictly Server-Side)
# ------------------------------------------------------------------------------
# Created in Google Cloud Console with Google Sheets API enabled:
GOOGLE_SERVICE_ACCOUNT_EMAIL=sunidhi-sheets-sync@your-project.iam.gserviceaccount.com

# Service Account Private Key from the generated JSON key file:
# When pasting on hosting platforms (Vercel, Railway, Node), preserve literal \n:
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. SERVER-SIDE CACHING & PERFORMANCE
# ------------------------------------------------------------------------------
# Cache Time-To-Live in seconds for server-side memory cache (Default: 300s = 5 min).
# Prevents exhausting Google Sheets API quotas while serving instant edge responses.
CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 5. ADMIN AUTHENTICATION & ACCESS CONTROL
# ------------------------------------------------------------------------------
# Strong passphrase required for operator login at /admin/login and API routes.
# Also used as HMAC secret key to cryptographically sign 7-day session cookies.
ADMIN_PASSWORD=generate_a_secure_long_random_passphrase_here
ADMIN_SECRET=generate_a_secure_long_random_passphrase_here
